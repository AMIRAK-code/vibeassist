{
  "comment": "Shared by the Pre-flight Scanner (supabase/functions/_shared/engine/secrets.ts) and the GitHub Action's pre-commit hook (github-action/scripts/secret-patterns.json). Keep the two files identical; a test checks it.",
  "patterns": [
    { "id": "aws_access_key", "title": "AWS access key", "severity": "critical", "regex": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "id": "github_token", "title": "GitHub token", "severity": "critical", "regex": "\\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}\\b|\\bgithub_pat_[A-Za-z0-9_]{60,}\\b" },
    { "id": "stripe_secret", "title": "Stripe live secret key", "severity": "critical", "regex": "\\b(sk|rk)_live_[A-Za-z0-9]{20,}\\b" },
    { "id": "anthropic_key", "title": "Anthropic API key", "severity": "critical", "regex": "\\bsk-ant-[A-Za-z0-9_-]{20,}" },
    { "id": "openai_key", "title": "OpenAI API key", "severity": "critical", "regex": "\\bsk-(proj-)?[A-Za-z0-9_-]{32,}" },
    { "id": "google_api_key", "title": "Google API key", "severity": "high", "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b" },
    { "id": "slack_token", "title": "Slack token", "severity": "high", "regex": "\\bxox[abposr]-[A-Za-z0-9-]{10,}" },
    { "id": "private_key", "title": "Private key", "severity": "critical", "regex": "-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY( BLOCK)?-----" },
    { "id": "client_secret_env", "title": "Secret in a variable the browser can read", "severity": "high", "regex": "\\b(VITE|NEXT_PUBLIC|REACT_APP|EXPO_PUBLIC)_[A-Z0-9_]*(SECRET|SERVICE_ROLE|PRIVATE)[A-Z0-9_]*\\s*[=:]" },
    { "id": "generic_secret", "title": "Hard-coded password or secret", "severity": "low", "regex": "\\b(password|passwd|secret|api_key|apikey|access_token)\\b\\s*[:=]\\s*['\"][^'\"\\s]{12,}['\"]", "flags": "i", "entropy": 3.5 }
  ]
}
